// Структура для хранения состояния (координаты и количество сделанных ходов)
struct State {
    int x, y, dist;
};

// ==========================================
// А) Реализация очереди через статический массив
// ==========================================
class QueueArray {
private:
    static const int MAX_SIZE = 100; // Для доски 8x8 в очереди никогда не будет больше 64 элементов
    State arr[MAX_SIZE];
    int f, r; // front и rear
public:
    QueueArray() : f(0), r(0) {}
    void push(State s) { arr[r++] = s; }
    void pop() { f++; }
    State front() { return arr[f]; }
    bool empty() { return f == r; }
    void clear() { f = 0; r = 0; }
};

// ==========================================
// Б) Реализация очереди через связанный список
// ==========================================
struct Node {
    State data;
    Node* next;
    Node(State s) : data(s), next(nullptr) {}
};

class QueueLinkedList {
private:
    Node* head;
    Node* tail;
public:
    QueueLinkedList() : head(nullptr), tail(nullptr) {}
    
    // Правильное управление памятью при уничтожении
    ~QueueLinkedList() { clear(); }

    void push(State s) {
        Node* newNode = new Node(s);
        if (tail == nullptr) {
            head = tail = newNode;
            return;
        }
        tail->next = newNode;
        tail = newNode;
    }

    void pop() {
        if (head == nullptr) return;
        Node* temp = head;
        head = head->next;
        if (head == nullptr) tail = nullptr;
        delete temp;
    }

    State front() { return head->data; }
    
    bool empty() { return head == nullptr; }
    
    void clear() {
        while (!empty()) {
            pop();
        }
    }
};

