// Возможные ходы коня (8 направлений)
int dx[] = {-2, -1, 1, 2, -2, -1, 1, 2};
int dy[] = {-1, -2, -2, -1, 1, 2, 2, 1};

// Проверка выхода за пределы доски
bool isValid(int x, int y) {
    return (x >= 0 && x < 8 && y >= 0 && y < 8);
}

// Шаблонная функция для использования любой из трех очередей
template <typename Q>
int getMinKnightMoves(string start, string end, Q& q) {
    int startX = start[0] - 'A';
    int startY = start[1] - '1';
    int endX = end[0] - 'A';
    int endY = end[1] - '1';

    if (startX == endX && startY == endY) return 0;

    bool visited[8][8] = {false};
    
    q.push({startX, startY, 0});
    visited[startX][startY] = true;

    while (!q.empty()) {
        State current = q.front();
        q.pop();

        if (current.x == endX && current.y == endY) {
            return current.dist;
        }

        for (int i = 0; i < 8; ++i) {
            int nx = current.x + dx[i];
            int ny = current.y + dy[i];

            if (isValid(nx, ny) && !visited[nx][ny]) {
                visited[nx][ny] = true;
                q.push({nx, ny, current.dist + 1});
            }
        }
    }
    return -1; // Путь не найден (в теории для шахматной доски недостижимо)
}

// Обертка для STL очереди, так как у нее нет метода clear() из коробки
class QueueSTL {
    queue<State> q;
public:
    void push(State s) { q.push(s); }
    void pop() { q.pop(); }
    State front() { return q.front(); }
    bool empty() { return q.empty(); }
    void clear() { 
        while(!q.empty()) q.pop(); 
    }
};

